# OpenCode Go API Key (obtained from https://opencode.ai/console)
OPENCODE_API_KEY=your_opencode_api_key_here

# Proxy host and port
PROXY_HOST=127.0.0.1
PROXY_PORT=8080

# OpenCode Go endpoints
OPENCODE_CHAT_ENDPOINT=https://opencode.ai/inference/go/openai/v1/chat/completions
OPENCODE_MODELS_ENDPOINT=https://opencode.ai/inference/go/v1/models

# Default Model ID (e.g., deepseek-v4.1-flash)
DEFAULT_MODEL=deepseek-v4.1-flash

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
